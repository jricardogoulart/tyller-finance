# ==========================================
# TyllerFinance - Profesional gitignore
# ==========================================

# ── Dependency Directories ──
node_modules/
**/node_modules/
jspm_packages/
web_components/

# ── Secrets and Environment Variables ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
back/.env
front/.env
.env*.local

# ── User Financial Statements (Proactive Data Leak Prevention) ──
*.ofx
*.qfx
*.csv
*.pdf
*.xls
*.xlsx
!extrato_teste.ofx  # Keep mock test statement for verification

# ── Build and Compilation Outputs ──
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.parcel-cache/
.eslintcache

# ── Logs, Debugging and Diagnostics ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/
*.log.*
.pnpm-debug.log*

# ── IDE and Editor Settings ──
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
.nbproject/
*.bak
*.tmp
*.temp

# ── OS-specific files ──
.planning
.GEMINI.md
.PROJECT.md
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Testing Caching and Coverage ──
coverage/
**/coverage/
.nyc_output/
.jest/
.vitest/
.cache/
